REACT_APP_API_URL=http://localhost:8000

# ── OpenAI ────────────────────────────────────────────────────────────
# Server-side only. Set this in Vercel Project Settings (NOT prefixed with
# REACT_APP_). The /api/openai proxy uses it; it is never sent to the browser.
OPENAI_API_KEY=sk-...
# Optional
# OPENAI_ORG_ID=org-...

# Frontend OpenAI base URL. Leave unset in production — the app defaults to
# `${window.location.origin}/api/openai` (the serverless proxy, same origin,
# no CORS, key stays on the server).
# For local `npm start` (no proxy running) either run `vercel dev`, or bypass
# the proxy by pointing directly at OpenAI with a dev key:
#   REACT_APP_OPENAI_BASE_URL=https://api.openai.com/v1
#   REACT_APP_OPENAI_API_KEY=sk-...   # dev only
